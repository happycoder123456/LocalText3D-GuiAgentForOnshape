# OnshapeGuiAgent — optional environment variables.
# Copy to .env on YOUR machine only. .env is gitignored.

# Agent dataset folder (episodes, memory, screenshots, videos, browser profile).
# Default: ~/OnshapeGuiAgent/agent_dataset
ONSHAPE_AGENT_DATASET=/path/to/agent_dataset

# The agent only ever talks to Ollama on this machine. Keep it loopback.
OLLAMA_URL=http://127.0.0.1:11434
